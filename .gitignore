# ============================================================
# .gitignore —— 这份清单告诉 git：“这些文件永远不要提交”
# 一行一个规则，# 开头的是注释
# ============================================================

# ---------- 密码与本地配置：绝对不能提交 ----------
db_config.py

# ---------- Python 运行时自动生成的产物 ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- 编辑器 / IDE 的项目本地文件 ----------
.idea/
.vscode/

# ---------- 临时文件（比如 Code Runner 生成的） ----------
tempCodeRunnerFile.py
*.tmp

# ---------- Windows 系统文件 ----------
Thumbs.db
Desktop.ini
